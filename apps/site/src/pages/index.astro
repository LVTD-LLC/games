---
import games from '../../../../games.json';
import Catalogue from '../layouts/Catalogue.astro';
---

<Catalogue title="Games — LVTD Games">
  <h1>Games</h1>
  <ul class="games" aria-label="Game collection">
    {games.map((game) => (
      <li>
        <a class="game" data-game={game.slug} href={`/${game.slug}/`}>
          <img
            class="logo"
            src={`/games${game.logo}`}
            alt=""
            width="104"
            height="104"
          />
          <div class="details">
            <h2 lang={game.language}>{game.title}</h2>
            <p>{game.description}</p>
          </div>
          <span class="play">
            Play <span aria-hidden="true">→</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</Catalogue>

<style>
  .games {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid #d8d6cf;
  }
  .game {
    display: flex;
    gap: clamp(14px, 3vw, 28px);
    align-items: center;
    padding: 20px 4px;
    border-bottom: 1px solid #d8d6cf;
  }
  .game:hover {
    background: #f1f0e9;
  }
  .logo {
    width: clamp(48px, 6vw, 68px);
    height: auto;
    border-radius: 12px;
  }
  h2 {
    font-size: clamp(18px, 2vw, 24px);
    line-height: 1.2;
    letter-spacing: -0.04em;
    margin: 0;
  }
  p {
    color: #53574e;
    font-size: 15px;
    margin: 4px 0 0;
  }
  .play {
    white-space: nowrap;
    font-size: 14px;
    margin-left: auto;
  }
  @media (max-width: 520px) {
    .play {
      font-size: 0;
    }
    .play span {
      font-size: 20px;
    }
  }
</style>

<script>
  import '../lib/catalogue.js';
</script>
