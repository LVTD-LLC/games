---
import games from '../../../../games.json';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>LVTD Games — маленькие игры, хорошая пауза</title>
    <meta
      name="description"
      content="Небольшие браузерные игры от LVTD. Начните с русской версии Wordle: пять букв, шесть попыток, новое слово каждый день."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f7f7f0" />
  </head>
  <body>
    <header>
      <a class="brand" href="/" aria-label="LVTD Games, главная">
        <span class="mark">
          L<span>•</span>
        </span>{' '}
        LVTD <span class="muted">/ games</span>
      </a>
      <span class="top-note">МАЛЕНЬКАЯ ПАУЗА ДЛЯ СЕБЯ</span>
    </header>
    <main>
      <section class="intro">
        <div class="eyebrow">
          <i></i> ОТКРЫТО ДЛЯ ИГРЫ
        </div>
        <h1>
          Отложите дела.
          <br />
          Сыграйте <em>немного.</em>
        </h1>
        <p>
          Небольшие игры для любопытных умов.
          <br />
          Без установок, регистраций и лишнего шума.
        </p>
        <a class="jump" href="#collection">
          Найти свою игру <span>↓</span>
        </a>
        <div class="doodle" aria-hidden="true">
          <span>И</span>
          <span>Г</span>
          <span>Р</span>
          <span>А</span>
          <small>ещё одну?</small>
        </div>
      </section>
      <section id="collection" aria-labelledby="collection-title">
        <div class="section-head">
          <h2 id="collection-title">Игровая полка</h2>
          <span>01 / НАЧАЛО КОЛЛЕКЦИИ</span>
        </div>
        <div class="collection">
          {games.map((game) => (
            <a class="game-card" href={`/${game.slug}/`}>
              <div class="art" aria-hidden="true">
                <span class="tag">СЛОВО ДНЯ</span>
                <div class="tiles">
                  <b>С</b>
                  <b>Л</b>
                  <b>О</b>
                  <b>В</b>
                  <b>О</b>
                </div>
                <span class="art-note">Пять букв. Много возможностей.</span>
              </div>
              <div class="card-body">
                <div class="meta">
                  {game.category}
                  <span>{game.duration}</span>
                </div>
                <h3>
                  {game.title}
                  <span>↗</span>
                </h3>
                <p>{game.description}</p>
                <span class="play">
                  Играть <span>→</span>
                </span>
              </div>
            </a>
          ))}
          <div class="coming">
            <span class="spark" aria-hidden="true">
              ✳
            </span>
            <h3>Место для следующей игры</h3>
            <p>
              Коллекция только начинается.
              <br />
              Заглядывайте, здесь будет интересно.
            </p>
            <span class="soon">ПРОДОЛЖЕНИЕ СЛЕДУЕТ</span>
          </div>
        </div>
      </section>
    </main>
    <footer>
      <span>LVTD Games</span>
      <span>Создано из любопытства. Для удовольствия.</span>
      <span>Хорошей игры ↗</span>
    </footer>
  </body>
</html>
<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(html) {
    scroll-behavior: smooth;
  }
  :global(body) {
    margin: 0;
    background: #f7f7f0;
    color: #23392f;
    font-family: Arial, Helvetica, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  :global(a) {
    color: inherit;
    text-decoration: none;
  }
  :global(a:focus-visible) {
    outline: 3px solid #527754;
    outline-offset: 6px;
  }
  header,
  main,
  footer {
    max-width: 1120px;
    margin: auto;
  }
  header {
    height: 110px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #dcded4;
  }
  .brand {
    display: flex;
    gap: 10px;
    align-items: center;
    font-weight: 700;
    font-size: 21px;
    letter-spacing: -0.7px;
  }
  .mark {
    width: 35px;
    height: 35px;
    border-radius: 10px;
    background: #23392f;
    color: #daeea3;
    padding: 5px 9px;
    margin-right: 4px;
  }
  .mark span {
    color: #f4bb82;
  }
  .muted {
    color: #768077;
    font-weight: 400;
  }
  .top-note,
  .eyebrow,
  .section-head > span,
  .soon {
    font-size: 10px;
    letter-spacing: 1.8px;
  }
  .top-note {
    color: #737e74;
  }
  .intro {
    position: relative;
    padding: 82px 0 76px;
  }
  .eyebrow {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .eyebrow i {
    width: 7px;
    height: 7px;
    background: #64855c;
    border-radius: 50%;
  }
  h1 {
    font-size: clamp(42px, 5.5vw, 70px);
    letter-spacing: -3px;
    line-height: 1.08;
    font-weight: 500;
    margin: 29px 0 24px;
  }
  h1 em {
    font-family: Georgia, serif;
    font-weight: 400;
    color: #668056;
  }
  .intro p {
    font-size: 16px;
    line-height: 1.8;
    color: #6c776e;
  }
  .jump {
    display: inline-flex;
    gap: 40px;
    font-size: 13px;
    margin-top: 24px;
    padding-bottom: 10px;
    border-bottom: 1px solid #23392f;
  }
  .doodle {
    position: absolute;
    right: 20px;
    top: 135px;
    transform: rotate(-9deg);
    width: 285px;
    display: grid;
    grid-template-columns: repeat(2, 100px);
    gap: 12px;
  }
  .doodle > span {
    height: 100px;
    border-radius: 17px;
    background: #e9eddf;
    border: 1px solid #d9e0ca;
    display: grid;
    place-items: center;
    font-size: 46px;
    font-weight: 700;
    color: #59744c;
    box-shadow: 0 5px 0 #d8dfcc;
  }
  .doodle > span:nth-child(2) {
    background: #dfecb7;
    transform: rotate(12deg) translate(5px, -8px);
  }
  .doodle > span:nth-child(3) {
    background: #f2d0a7;
    color: #946341;
  }
  .doodle small {
    font: italic 19px Georgia;
    position: absolute;
    right: 0;
    bottom: -40px;
    transform: rotate(8deg);
  }
  .section-head {
    border-top: 1px solid #dcded4;
    padding: 28px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  h2 {
    font-size: 18px;
    font-weight: 500;
    margin: 0;
  }
  .section-head > span {
    color: #7c8377;
  }
  .collection {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 26px;
  }
  .game-card {
    border: 1px solid #dce1d1;
    border-radius: 18px;
    overflow: hidden;
    background: #fffef8;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }
  .game-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 30px #23392f0d;
  }
  .art {
    height: 235px;
    background: #e8eddd;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 24px;
  }
  .tag {
    position: absolute;
    left: 22px;
    top: 22px;
    font-size: 9px;
    letter-spacing: 1.6px;
    padding: 7px 10px;
    border-radius: 20px;
    background: #ffffff80;
  }
  .tiles {
    display: flex;
    gap: 7px;
    transform: rotate(-5deg);
    margin-top: 20px;
  }
  .tiles b {
    display: grid;
    place-items: center;
    width: 56px;
    height: 64px;
    background: #fafcf6;
    border: 1px solid #d5ddcc;
    border-radius: 8px;
    font-size: 27px;
    box-shadow: 0 4px 0 #cdd5c2;
  }
  .tiles b:nth-child(1),
  .tiles b:nth-child(5) {
    background: #69865d;
    color: white;
    border-color: #69865d;
    box-shadow: 0 4px 0 #527348;
  }
  .tiles b:nth-child(3) {
    background: #d8b568;
    color: #fff;
    box-shadow: 0 4px 0 #c2a052;
  }
  .art-note {
    font-size: 11px;
    color: #718064;
  }
  .card-body {
    padding: 26px;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    color: #7a8375;
    font-size: 11px;
  }
  h3 {
    font-size: 27px;
    font-weight: 500;
    letter-spacing: -0.7px;
    margin: 18px 0 12px;
  }
  .card-body h3 {
    display: flex;
    justify-content: space-between;
  }
  .card-body h3 span {
    font-size: 23px;
    color: #7a8375;
  }
  .card-body p,
  .coming p {
    font-size: 14px;
    line-height: 1.8;
    color: #727c70;
  }
  .play {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 23px;
    margin-top: 24px;
    border-top: 1px solid #e4e6dc;
    font-size: 13px;
  }
  .play > span {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #edf1e4;
    display: grid;
    place-items: center;
  }
  .coming {
    border: 1px dashed #d4dacb;
    border-radius: 18px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 40px;
  }
  .spark {
    font-size: 66px;
    font-weight: 300;
    color: #a8b894;
  }
  .coming h3 {
    font-size: 21px;
    margin-top: 22px;
  }
  .soon {
    margin-top: 26px;
    color: #8b9483;
  }
  footer {
    margin-top: 76px;
    padding: 30px 0 40px;
    border-top: 1px solid #dcded4;
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: #7b8377;
  }
  footer span:first-child {
    font-weight: bold;
    color: #23392f;
  }
  @media (max-width: 1180px) {
    header,
    main,
    footer {
      margin-left: 30px;
      margin-right: 30px;
    }
  }
  @media (max-width: 720px) {
    header {
      height: 80px;
    }
    .top-note {
      display: none;
    }
    .intro {
      padding: 50px 0;
    }
    .doodle {
      display: none;
    }
    h1 {
      letter-spacing: -2px;
    }
    .collection {
      grid-template-columns: 1fr;
    }
    .section-head > span {
      font-size: 8px;
      letter-spacing: 1px;
    }
    .coming {
      min-height: 280px;
    }
    footer {
      gap: 20px;
      flex-wrap: wrap;
      margin-top: 45px;
    }
    .art {
      height: 220px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
    .game-card {
      transition: none;
    }
  }
</style>
