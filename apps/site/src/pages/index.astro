---
import games from '../../../../games.json';
import Catalogue from '../layouts/Catalogue.astro';
---

<Catalogue title="Games — LVTD Games">
  <h1>Games</h1>
  <ul class="games" aria-label="Game collection">
    {games.map((game) => (
      <li>
        <a class="game" href={`/${game.slug}/`}>
          <img class="logo" src={game.logo} alt="" width="104" height="104" />
          <h2 lang={game.language}>{game.title}</h2>
          <span class="play">
            Play <span aria-hidden="true">→</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</Catalogue>

<style>
  .games {
    display: grid;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .game {
    display: flex;
    align-items: center;
    gap: 28px;
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: var(--surface);
    transition:
      background-color 160ms,
      border-color 160ms;
  }
  .game:hover {
    background: var(--surface-hover);
    border-color: var(--purple);
  }
  .logo {
    flex: none;
    border-radius: 22px;
  }
  h2 {
    margin: 0;
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 700;
    letter-spacing: -0.8px;
  }
  .play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    margin-left: auto;
    padding: 16px 24px;
    border-radius: 12px;
    background: var(--purple);
    font-size: 17px;
    font-weight: 700;
  }
  .play span {
    font-size: 23px;
    line-height: 1;
  }
  @media (max-width: 600px) {
    .game {
      display: grid;
      grid-template-columns: 72px minmax(0, 1fr);
      gap: 20px;
      padding: 20px;
    }
    .logo {
      width: 72px;
      height: 72px;
      border-radius: 16px;
    }
    h2 {
      overflow-wrap: anywhere;
    }
    .play {
      grid-column: 1 / -1;
      margin: 0;
      justify-content: space-between;
      padding: 14px 18px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .game {
      transition: none;
    }
  }
</style>
