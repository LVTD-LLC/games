---
import '../../../../shared/studio.css';
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'A collection of browser games by LVTD. Pick a game and play.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf9f5" />
    <link rel="icon" href="/games/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header>
      <a class="studio-link" href="https://lvtd.dev/" aria-label="LVTD home">
        LVTD
      </a>
      <nav aria-label="Primary navigation">
        <a href="https://lvtd.dev/projects/">Projects</a>
        <a
          href="/games/"
          aria-current={Astro.url.pathname === '/games/' ? 'page' : undefined}
        >
          Games
        </a>
        <a href="https://lvtd.dev/research/">Research</a>
        <a href="https://lvtd.dev/blog/">Blog</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <script>
      import '../lib/analytics.js';
    </script>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    color: #252820;
    background: #faf9f5;
    font:
      16px/1.5 system-ui,
      sans-serif;
  }
  main,
  header {
    width: min(1080px, calc(100% - 40px));
    margin-inline: auto;
  }
  header,
  nav {
    display: flex;
    align-items: center;
    gap: clamp(12px, 3vw, 32px);
  }
  header {
    justify-content: space-between;
    flex-wrap: wrap;
    padding-block: 18px;
    border-bottom: 1px solid #d8d6cf;
  }
  header .studio-link {
    border: none;
    padding: 0;
    font-size: 22px;
    font-weight: 750;
  }
  nav a {
    padding-block: 10px;
    font-size: 14px;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  nav a:hover,
  nav a[aria-current],
  .back {
    text-decoration: underline;
    text-underline-offset: 6px;
  }
  a:focus-visible {
    outline: 2px solid #9a432a;
    outline-offset: 3px;
  }
  .skip {
    position: absolute;
    top: 4px;
    left: 4px;
    padding: 10px;
    background: white;
    transform: translateY(-150%);
  }
  .skip:focus {
    transform: none;
  }
  h1 {
    font:
      normal clamp(48px, 7vw, 86px)/1 Georgia,
      serif;
    letter-spacing: -0.055em;
    margin: 0;
    padding-block: clamp(40px, 7vw, 76px);
  }
  main {
    padding-bottom: 64px;
  }
</style>
