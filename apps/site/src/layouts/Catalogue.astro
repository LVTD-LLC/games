---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'A collection of browser games by LVTD. Pick a game and play.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1b1033" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header>
      <a class="brand" href="/" aria-label="LVTD Games home">
        <img src="/favicon.svg" width="40" height="40" alt="" />
        LVTD Games
      </a>
    </header>
    <main>
      <slot />
    </main>
    <script>
      import '../lib/analytics.js';
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --background: #1b1033;
    --surface: #2c194b;
    --surface-hover: #38205e;
    --purple: #8950ef;
    --lavender: #cfb5ff;
    --text: #faf7ff;
    --border: #503475;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    min-height: 100dvh;
    background: var(--background);
    color: var(--text);
    font-family: Arial, Helvetica, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:focus-visible {
    outline: 3px solid var(--lavender);
    outline-offset: 6px;
  }
  header,
  main {
    width: min(1040px, calc(100% - 64px));
    margin-inline: auto;
  }
  header {
    padding-block: 32px;
    border-bottom: 1px solid var(--border);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.7px;
  }
  main {
    padding-block: 64px 96px;
  }
  h1 {
    margin: 0 0 40px;
    font-size: clamp(40px, 6vw, 64px);
    line-height: 1.1;
    letter-spacing: -2px;
  }
  @media (max-width: 600px) {
    header,
    main {
      width: calc(100% - 40px);
    }
    header {
      padding-block: 24px;
    }
    main {
      padding-block: 40px 64px;
    }
    h1 {
      margin-bottom: 28px;
    }
  }
</style>
